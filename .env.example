# Copy this file to .env and fill in your actual values.
# .env is listed in .gitignore and will never be committed.

# Core LLM / Embedding / Vision LLM credentials
OPENAI_API_KEY=sk-***

# Vector store base directory (maps to config.vector_store.persist_directory)
# Typically keep default and mount /app/data in Docker.
DB_PATH=./data/db/chroma

# Observability and logging
LOG_LEVEL=INFO
TRACE_FILE=./logs/traces.jsonl

# Dashboard configuration (optionally override defaults)
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0

